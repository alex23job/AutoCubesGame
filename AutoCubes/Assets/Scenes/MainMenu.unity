--- !u!114 &1052985229
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1052985227}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 008cb7f729878df41914f8bb159a1171, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ru: "\u041D\u0430 \u044D\u0442\u043E\u043C \u044D\u043A\u0440\u0430\u043D\u0435
    \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u0440\u0435\u0436\u0438\u043C \u0438 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0438\u0433\u0440\u044B. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0434\u0432\u0430
    \u0440\u0435\u0436\u0438\u043C\u0430 \u0438\u0433\u0440\u044B \"\u0421\u043A\u043B\u0430\u0434\"
    \u0438 \"\u041F\u0435\u0440\u0435\u0435\u0437\u0434\" \u043D\u0430 \u043B\u0435\u0432\u043E\u0439
    \u0438 \u043F\u0440\u0430\u0432\u043E\u0439 \u043F\u0430\u043D\u0435\u043B\u044F\u0445
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E.
    \u0414\u043B\u044F \u0440\u0435\u0436\u0438\u043C\u0430 \"\u0421\u043A\u043B\u0430\u0434\"
    \u0435\u0441\u0442\u044C 10 \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438.
    \u0411\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0443\u0440\u043E\u0432\u043D\u0438
    \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u043F\u0440\u043E\u0441\u0442\u044B\u0445. \u041D\u0443\u0436\u043D\u043E \u0443\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u043E\u0432\u044B\u0432\u0430\u0442\u044C
    \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435\u0435 \u0447\u0438\u0441\u043B\u043E
    \u043C\u0430\u0448\u0438\u043D \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u043A\u0430\u0437\u043E\u0432.
    \u0421 4 \u0443\u0440\u043E\u0432\u043D\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0437\u0430\u043A\u0430\u0437\u044B, \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0438\u0435
    \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443 \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445
    \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445, \u043F\u0440\u0438 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0438
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u043D\u0430\u0433\u0440\u0430\u0434\u0430.  \u0414\u043B\u044F \u0440\u0435\u0436\u0438\u043C\u0430
    \"\u041F\u0435\u0440\u0435\u0435\u0437\u0434\" \u0435\u0441\u0442\u044C 4 \u0443\u0440\u043E\u0432\u043D\u044F
    \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
    \u0441\u0440\u0430\u0437\u0443. \u041E\u043D\u0438 \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
    \u0444\u043E\u0440\u043C\u043E\u0439 \u0443\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u043E\u0432\u044B\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    \u043A\u0443\u0437\u043E\u0432\u0430. \u0412\u0441\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
    \u0441 \u0432\u0435\u0449\u0430\u043C\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0431\u044B\u0442\u044C \u0443\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u043A\u0443\u0437\u043E\u0432
    \u0437\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0432 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0432\u0448\u0435\u043C\u0441\u044F
    \u0440\u0435\u0436\u0438\u043C\u0435 \u0438\u0433\u0440\u044B \u043A\u043B\u0438\u043A\u043E\u043C
    \u043C\u044B\u0448\u0438 \u043F\u043E \u043D\u0435\u043C\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0418\u0433\u0440\u0430\u0442\u044C\"
    \u0432 \u044D\u0442\u043E\u0439 \u043F\u0430\u043D\u0435\u043B\u0438!"
  en: On this screen, you can select the mode and difficulty of the game. There are
    two game modes available, "Warehouse" and "Moving" on the left and right panels,
    respectively. There are 10 difficulty levels for the Warehouse mode. More difficult
    levels become available after completing the simple ones. We need to equip more
    and more machines and send more orders. From level 4, orders appear that require
    transportation under certain temperature conditions, subject to which an additional
    reward is awarded.  For the "Moving" mode, there are 4 difficulty levels available
    at once. They differ in the shape of the completed body. All boxes with things
    must be stowed in the back in a limited time. Select the difficulty level in
    the game mode you like by clicking on it and click the "Play" button in this
    panel!
--- !u!114 &1052985230
