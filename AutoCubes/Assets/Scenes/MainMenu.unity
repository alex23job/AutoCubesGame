  m_Script: {fileID: 11500000, guid: 008cb7f729878df41914f8bb159a1171, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ru: "\u0412 \u0440\u0435\u0436\u0438\u043C\u0435 \"\u0421\u043A\u043B\u0430\u0434\"
    \u0412\u0430\u0441 \u0436\u0434\u0443\u0442 10 \u0443\u0440\u043E\u0432\u043D\u0435\u0439
    \u0440\u0430\u0437\u043D\u043E\u0439 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438.
    \u041D\u0443\u0436\u043D\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
    \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0430\u0448\u0438\u043D
    \u0438 \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0432\u0441\u0451
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u043A\u0430\u0437\u043E\u0432.
    \u0421 4 \u0443\u0440\u043E\u0432\u043D\u044F \u0447\u0430\u0441\u0442\u044C
    \u043A\u043E\u0440\u043E\u0431\u043E\u043A \u0441 \u0437\u0430\u043A\u0430\u0437\u0430\u043C\u0438
    \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u044B
    \u0437\u043D\u0430\u043A\u0430\u043C\u0438 \"\u0421\u043D\u0435\u0436\u0438\u043D\u043A\u0430\"
    \u0438 \"\u0413\u0440\u0430\u0434\u0443\u0441\u043D\u0438\u043A\". \u042D\u0442\u0438
    \u0442\u043E\u0432\u0430\u0440\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B
    \u043A \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u0432\u043E\u0437\u0434\u0443\u0445\u0430
    \u0438 \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0437\u0438\u0442\u044C\u0441\u044F,
    \u043A\u043E\u0433\u0434\u0430 \u0442\u0435\u043F\u043B\u043E, \u0438\u043B\u0438
    \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u044B
    \u043C\u043E\u0440\u043E\u0437\u043E\u043C. \u0417\u0430 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443
    \u043A\u043E\u0440\u043E\u0431\u043E\u043A \u0441 \u0437\u0430\u043A\u0430\u0437\u0430\u043C\u0438
    \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F \u043E\u043F\u044B\u0442
    \u0438 \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
    \u043E\u0431\u044A\u0451\u043C\u0443 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
    (\u0447\u0438\u0441\u043B\u043E \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043E\u0432
    \u0432 \u043D\u0435\u0439). \u0417\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u0443\u044E
    \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443 \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
    \u043A\u0443\u0437\u043E\u0432\u0435 \u043A\u043E\u0440\u043E\u0431\u043E\u043A,
    \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043A \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435, \u043E\u043F\u044B\u0442\u0430
    \u0438 \u043C\u043E\u043D\u0435\u0442 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435. \u0423 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0412\u0430\u0448\u0438\u0445 \u043C\u0430\u0448\u0438\u043D \u043A\u0443\u0437\u043E\u0432\u0430
    \u0431\u0443\u0434\u0443\u0442 3 \u0442\u0438\u043F\u043E\u0432: \u043D\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u044B\u0439,
    \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u044B\u0439 \u0438 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A.
    \u0412 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u043E\u043C \u043A\u0443\u0437\u043E\u0432\u0435
    \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0441\u043E \u0437\u043D\u0430\u0447\u043A\u043E\u043C 
    \"\u0413\u0440\u0430\u0434\u0443\u0441\u043D\u0438\u043A\" \u043D\u0435 \"\u0437\u0430\u043C\u0435\u0440\u0437\u043D\u0443\u0442\",
    \u0430 \u0432 \u0445\u043E\u043B\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0435
    \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0441\u043E \u0437\u043D\u0430\u0447\u043A\u043E\u043C
    \"\u0421\u043D\u0435\u0436\u0438\u043D\u043A\u0430\" \u0442\u043E\u0447\u043D\u043E
    \u043D\u0435 \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0437\u044F\u0442\u0441\u044F.
    \u0412 \u043D\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u043E\u043C
    \u043A\u0443\u0437\u043E\u0432\u0435 \u043D\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
    \u0432\u043B\u0438\u044F\u0435\u0442 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
    \u0432\u043E\u0437\u0434\u0443\u0445\u0430, \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0434\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0443\u0440\u043E\u0432\u043D\u044F \u0432\u0438\u0434\u043D\u043E \u043D\u0430
    \u0442\u0430\u0431\u043B\u043E \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0430
    \u0441\u043A\u043B\u0430\u0434\u0430. \u0415\u0441\u043B\u0438 \u043A\u043E\u0440\u043E\u0431\u043A\u0430
    \u0441\u043E \u0437\u043D\u0430\u0447\u043A\u043E\u043C \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F
    \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0435 \u043E\u0442
    \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B, \u0442\u043E
    \u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0449\u0442\u0440\u0430\u0444
    \u0438 \u043E\u043F\u044B\u0442 \u043D\u0430\u0447\u0438\u0441\u043B\u0435\u043D
    \u043D\u0435 \u0431\u0443\u0434\u0435\u0442. \u041A\u043E\u0433\u0434\u0430 \u0412\u044B
    \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u043A\u0443\u0437\u043E\u0432
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F \u043D\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
    \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u0442\u0430\u0439\u043C\u0435\u0440
    \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438. \u041A\u043E\u0440\u043E\u0431\u043A\u0438
    \u0441 \u0437\u0430\u043A\u0430\u0437\u0430\u043C\u0438 \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C \u043D\u0435\u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0439
    \u0434\u043B\u044F 100% \u0443\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u043E\u0432\u0430\u043D\u0438\u044F
    \u043A\u0443\u0437\u043E\u0432\u0430 \u0444\u043E\u0440\u043C\u044B. \u0412 \u044D\u0442\u043E\u043C
    \u0441\u043B\u0443\u0447\u0430\u0435 \u043C\u0430\u0448\u0438\u043D\u0443 \u043C\u043E\u0436\u043D\u043E
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432 \u0440\u0435\u0439\u0441,
    \u043A\u043B\u0438\u043A\u043D\u0443\u0432 \u043F\u043E \u043A\u043D\u043E\u043F\u043A\u0435
    \"\u0412 \u0440\u0435\u0439\u0441\". \u0415\u0441\u043B\u0438 \u0436\u0435 \u043A\u0443\u0437\u043E\u0432
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F \u0431\u0443\u0434\u0435\u0442
    \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E,
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432 \u0440\u0435\u0439\u0441 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438,
    \u0430 \u0412\u0430\u043C \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
    +20 \u043E\u0447\u043A\u043E\u0432 \u043E\u043F\u044B\u0442\u0430. \u0410\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C
    \u0443\u0435\u0434\u0435\u0442 \u0432 \u0440\u0435\u0439\u0441 \u0441\u0430\u043C
    \u043F\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438 \u0442\u0430\u0439\u043C\u0435\u0440\u0430.
    \u041A\u043E\u0433\u0434\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043F\u043E
    \u0447\u0438\u0441\u043B\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u043C\u0430\u0448\u0438\u043D \u0438 \u043A\u043E\u0440\u043E\u0431\u043E\u043A
    \u0441 \u0437\u0430\u043A\u0430\u0437\u0430\u043C\u0438 \u0431\u0443\u0434\u0443\u0442
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B, \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0441\u044F \u0438 \u043D\u0430\u0431\u0440\u0430\u043D\u043D\u044B\u0435
    \u043E\u043F\u044B\u0442 \u0438 \u043C\u043E\u043D\u0435\u0442\u044B \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F
    \u043D\u0430 \u0412\u0430\u0448 \u0441\u0447\u0451\u0442."
  en: 'There are 10 levels of varying difficulty in the Warehouse mode. We need to
    ship more and more cars and place more and more orders. From level 4, some of
    the order boxes will be marked with "Snowflake" and "Thermometer" signs. These
    products are sensitive to air temperature and can defrost when it is warm, or
    be spoiled by frost. Experience and coins are awarded for transporting boxes
    with orders in proportion to the volume of the box (the number of squares in
    it). More experience and coins are awarded for successful transportation of temperature-sensitive
    boxes in the right body. Your different cars will have 3 body types: leaky, airtight,
    and refrigerator. In a sealed body, the boxes with the Thermometer badge will
    not "freeze", and in the freezer, the boxes with the Snowflake badge will definitely
    not defrost. In an unpressurized body, the boxes are affected by the air temperature,
    the value of which for this level is visible on the scoreboard in the middle
    of the warehouse. If the box with the badge deteriorates during transportation
    due to the temperature, you will receive a fine and no experience will be credited.
    When you have filled the car body halfway, the dispatch timer starts. Order boxes
    may not be suitable for 100% complete body shape. In this case, the car can be
    sent on a flight by clicking on the "On flight" button. If the car body is completely
    filled, the car departs automatically, and you get +20 experience points. The
    car will leave on its own at the end of the timer. When the conditions for the
    number of shipped cars and order boxes are met, the level is completed and the
    accumulated experience and coins are credited to your account.'
--- !u!114 &1731825763
