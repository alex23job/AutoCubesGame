--- !u!114 &94126170
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 94126168}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 008cb7f729878df41914f8bb159a1171, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ru: "\u0412 \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044C \u0434\u0432\u0430
    \u0440\u0435\u0436\u0438\u043C\u0430 \"\u0421\u043A\u043B\u0430\u0434\" \u0438
    \"\u041F\u0435\u0440\u0435\u0435\u0437\u0434\". \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0432 \u043D\u0438\u0445 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0435.
    \u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u043A\u043E\u0440\u043E\u0431\u043A\u0435
    \u0441 \u0437\u0430\u043A\u0430\u0437\u043E\u043C \u043B\u0435\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u043A\u0438 \u0438
    \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0437\u0430\u043A\u0430\u0437
    \u0432 \u043A\u0443\u0437\u043E\u0432 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F.
    \u041A\u043E\u0433\u0434\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0430 \u0431\u0443\u0434\u0435\u0442
    \u0432 \u043D\u0443\u0436\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0438 \u043A\u043E\u0440\u043E\u0431\u043A\u0430
    \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0430
    \u0432 \u043A\u0443\u0437\u043E\u0432\u0435.  \u041C\u043E\u0436\u043D\u043E
    \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043A\u043E\u0440\u043E\u0431\u043A\u0443
    \u0441 \u0437\u0430\u043A\u0430\u0437\u043E\u043C, \u043A\u043B\u0438\u043A\u043D\u0443\u0432
    \u043F\u043E \u043D\u0435\u0439 \u043D\u0443\u0436\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E
    \u0440\u0430\u0437 \u0442\u0430\u043A\u0436\u0435 \u043B\u0435\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u043A\u0438."
  en: The game has two modes "Warehouse" and "Moving". They have the same controls.
    Click on the order box with the left mouse button and drag the order into the
    car body. When the box is in the right place, release the mouse button and the
    box will be placed in the body.  You can rotate the order box by clicking on
    it the required number of times with the left mouse button.
