--- !u!114 &1914291056
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1914291054}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 008cb7f729878df41914f8bb159a1171, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ru: "\u041D\u0430 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
    \u043C\u043E\u043D\u0435\u0442\u044B \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C
    \u043D\u043E\u0432\u044B\u0435 \u043C\u0430\u0448\u0438\u043D\u044B \u0432 \u0430\u0432\u0442\u043E\u0441\u0430\u043B\u043E\u043D\u0435.
    \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043C\u0430\u0448\u0438\u043D\u044B
    \u0434\u043B\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0437\u0430\u0432\u0438\u0441\u044F\u0442
    \u043E\u0442 \u0412\u0430\u0448\u0435\u0433\u043E \u043E\u043F\u044B\u0442\u0430
    \u0438 \u0438\u043C\u0435\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u0447\u0438\u0441\u043B\u0430
    \u043C\u043E\u043D\u0435\u0442. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
    \u043C\u0430\u0448\u0438\u043D \u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
    \u0434\u043B\u044F \u0438\u0445 \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0412\u044B
    \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u0438\u043F\u0430
    \u043C\u0430\u0448\u0438\u043D. \u041C\u0430\u0448\u0438\u043D\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442
    \u0440\u0430\u0437\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E \u0440\u0435\u0439\u0441\u043E\u0432.
    \u041C\u0430\u0448\u0438\u043D\u0443 \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0441 \u043D\u0443\u043B\u0435\u0432\u044B\u043C \u0447\u0438\u0441\u043B\u043E\u043C
    \u0440\u0435\u0439\u0441\u043E\u0432. \u0412 \u0433\u0430\u0440\u0430\u0436\u0435
    \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0412\u0430\u0448\u0438\u0445
    \u043C\u0430\u0448\u0438\u043D \u0438 \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u0434\u0435\u043D\u0435\u0433,
    \u043E\u0442\u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438\u0445. \u0422\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C
    \u043C\u0430\u0448\u0438\u043D\u044B, \u043D\u043E \u0432 \u0433\u0430\u0440\u0430\u0436\u0435
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0445\u043E\u0442\u044F
    \u0431\u044B \u043E\u0434\u043D\u0430 \u043C\u0430\u0448\u0438\u043D\u0430. "
  en: You can use the coins you earn to buy new cars at the dealership. The available
    machines to buy depend on your experience and the available number of coins.
    You can view the characteristics of the machines and the requirements for their
    purchase for each type of machine. The cars perform a different number of flights.
    The car cannot be used with zero flights. In the garage, you can view the condition
    of your cars and, if necessary and if you have the money, repair them. You can
    also sell cars, but there must be at least one car in the garage.
