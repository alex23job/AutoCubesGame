--- !u!114 &337485616
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 337485614}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 008cb7f729878df41914f8bb159a1171, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ru: "\u0412 \u0440\u0435\u0436\u0438\u043C\u0435 \"\u041F\u0435\u0440\u0435\u0435\u0437\u0434\"
    \u0412\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0432\u0441\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430
    \u0441\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u043A\u0443\u0437\u043E\u0432.
    \u041D\u0430 \u0412\u0430\u0448 \u0432\u044B\u0431\u043E\u0440 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
    4 \u0442\u0438\u043F\u0430 \u043A\u0443\u0437\u043E\u0432\u043E\u0432 \u0440\u0430\u0437\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B. \u0421\u0430\u043C\u044B\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
    \u043A\u0443\u0437\u043E\u0432 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B \u0438 \u0434\u0432\u0443\u043C\u044F \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438
    (\u0441\u043B\u043E\u044F\u043C\u0438) \u0434\u043B\u044F \u043A\u043E\u0440\u043E\u0431\u043E\u043A.
    \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0438\u043C\u0435\u044E\u0442
    \u0442\u0440\u0438 \u0441\u043B\u043E\u044F \u0438 \u0440\u0430\u0437\u043D\u044B\u0435
    \u0432\u044B\u0441\u0442\u0443\u043F\u044B \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0441\u043B\u043E\u044F\u0445. \u0415\u0441\u043B\u0438 \u0412\u0430\u043C \u043D\u0430
    \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C, \u043A\u0443\u0434\u0430
    \u0431\u044B\u043B\u0430 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0430
    \u0432 \u043A\u0443\u0437\u043E\u0432\u0435, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0451 \u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E, \u043A\u043B\u0438\u043A\u043D\u0443\u0432 \u043F\u043E
    \u043A\u043D\u043E\u043F\u043A\u0435  \u0441 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0439. \u041C\u043E\u0436\u043D\u043E
    \u0442\u0430\u043A \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043A\u043E\u0440\u043E\u0431\u043E\u043A, \u0438\u043B\u0438 \u0432\u0441\u0435,
    \u043A\u043B\u0438\u043A\u043D\u0443\u0432 \u043F\u043E \u043A\u043D\u043E\u043F\u043A\u0435
    \u0441 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0439 \u043A\u0440\u0443\u0433\u043E\u0432\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0439. \u0423\u0440\u043E\u0432\u0435\u043D\u044C
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
    \u0443\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u043A\u0443\u0437\u043E\u0432.
    \u0417\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u0443\u044E \u0443\u043A\u043B\u0430\u0434\u043A\u0443
    \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u043F\u044B\u0442
    \u0438 \u043C\u043E\u043D\u0435\u0442\u044B. \u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B
    \u0443\u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0432 \u043E\u0442\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F."
  en: In the "Moving" mode, you need to put all the customer's boxes in the body.
    There are 4 body types of different shapes available for your choice. The simplest
    body is rectangular in shape and has two levels (layers) for boxes. The rest
    have three layers and different projections on different layers. If you don't
    like where the box was placed in the back, you can return it to its original
    place by clicking on the button with the red arrow. You can lay out several boxes
    like this, or all of them by clicking on the button with the brown circular arrow.
    The level ends when all the boxes are stacked in the body. Experience and coins
    are awarded for successful stacking. You have to meet the allotted time.
--- !u!114 &337485617
